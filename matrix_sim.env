# IP/hostname of the Pi running matrix_server.py, read by the audio-sender
# systemd --user services (audio-spectrum, audio-oscope, audio-mondrian —
# see systemd-user/). Edit this value and run:
#
#   systemctl --user restart audio-spectrum audio-oscope audio-mondrian
#
# to pick it up — unlike pm2's ecosystem.config.js, systemd re-reads this
# file on every restart, so there's no need to delete/recreate the units.
MATRIX_HOST=192.168.1.109
